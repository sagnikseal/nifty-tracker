# ============================================================================
# NIFTY 50 v3.0 MoE & Media Intelligence Terminal — Environment Variables
# Copy this file to `.env` (`cp .env.example .env`) and fill in your credentials
# ============================================================================

# Active Broker Selection: auto | upstox | angelone | groww | public
NIFTY_BROKER=upstox

# ----------------------------------------------------------------------------
# OPTION A: 100% AUTOMATED DAILY TOKEN REFRESH VIA TOTP (RECOMMENDED)
# Upstox tokens expire every morning at 03:30 AM IST. When these 3 variables are
# set, `scripts/broker_auth.py` automatically computes the 6-digit RFC 6238 TOTP
# and calls `POST https://api.upstox.com/v2/totp-login/authorization/token` on
# startup and whenever a token expires—zero manual browser login required!
# ----------------------------------------------------------------------------
UPSTOX_API_KEY=your_upstox_oauth_api_key_here
UPSTOX_PIN=your_6_digit_upstox_pin_here
UPSTOX_TOTP_SECRET=your_base32_totp_secret_from_upstox_authenticator_setup

# Optional OAuth Redirect Secret (only needed if using browser OAuth code exchange)
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback

# ----------------------------------------------------------------------------
# OPTION B: MANUAL DAILY UPSTOX ACCESS TOKEN (Fallback if TOTP is not enabled)
# ----------------------------------------------------------------------------
UPSTOX_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# ANGELONE SMARTAPI AUTOMATED DAILY TOTP LOGIN (If using AngelOne)
# ----------------------------------------------------------------------------
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
ANGELONE_ACCESS_TOKEN=

# Groww Live API Token (optional)
GROWW_ACCESS_TOKEN=

# Admin PIN for Frontend -> Backend Configuration Sync (Default: 1234)
NIFTY_ADMIN_PIN=1234

# FastAPI Server Port
PORT=8000
