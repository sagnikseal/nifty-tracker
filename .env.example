# ============================================================================
# NIFTY engine: environment variables. Copy to `.env` and fill in. Never commit `.env`.
# Everything the engine uses is free: Yahoo / RSS / GDELT, your Upstox token, a local Ollama model.
# Paper trading only: no token here can place orders through this engine.
# ============================================================================

# --- Upstox (read-only market data) ------------------------------------------
# Analytics Token: 1-year, GET-only (quotes, candles, option chain, expired instruments with
# Upstox Plus, news, WebSocket feed). Generate it in the Upstox developer console.
# Without it: NIFTY/VIX come from Yahoo (~1 min delayed) and option prices are modelled from VIX.
UPSTOX_ANALYTICS_TOKEN=

# Optional alternative: a daily OAuth token, or the TOTP trio for automatic daily refresh.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=

# --- Local LLM (Ollama, free, on-device) ---------------------------------------
# Install: https://ollama.com  (macOS: `brew install ollama`). The launcher pulls the model.
# Compare models on your machine: python -m nifty_engine llm-bench
# NE_LLM_MODEL=qwen3.5:9b
# NE_LLM_URL=http://localhost:11434
# NE_LLM_KNOWLEDGE_CUTOFF=2026-03-10          # the model's training cutoff (or release date if unknown)
# NE_LLM_THINK=1                              # allow "thinking" (slower; off by default)

# --- Any engine setting can be overridden as NE_<SETTING> (see nifty_engine/config.py) ---
# NE_ATM_TARGET_INR=5000
# NE_ATM_STOP_INR=2000
# NE_ATM_ENTRY_THRESHOLD=0.60
