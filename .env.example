# ============================================================================
# NIFTY engine v5: environment variables. Copy to `.env` and fill in. Never commit `.env`.
# Everything the engine uses is free: Yahoo / GDELT / RSS, your Upstox token, a local Ollama model.
# ============================================================================

# --- Upstox (read-only market data; the engine never places orders) -----------
# Analytics Token: 1-year, GET-only (quotes, candles, option chain, expired instruments with
# Upstox Plus, news, WebSocket feed). Generate it in the Upstox developer console.
UPSTOX_ANALYTICS_TOKEN=

# Optional alternative: a daily OAuth token, or the TOTP trio for automatic daily refresh.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=

# --- Local LLM (Ollama, free, on-device) ---------------------------------------
# Install: https://ollama.com  (macOS: `brew install ollama`), then `ollama pull llama3.1:8b`.
# NE_LLM_MODEL=llama3.1:8b
# NE_LLM_URL=http://localhost:11434          # Docker on Mac: http://host.docker.internal:11434
# NE_LLM_KNOWLEDGE_CUTOFF=2023-12-31          # set to your model's training cutoff
# NE_LLM_THINK=false                          # only for thinking models (e.g. qwen3) to speed them up

# --- Any engine setting can be overridden as NE_<SETTING> (see nifty_engine/config.py) ---
# NE_CAPITAL=100000
# NE_FEATURE_GROUPS=base
# NE_USE_ZOO=false

# ----------------------------------------------------------------------------
# Legacy v3 terminal only (scripts/realtime_engine.py). Not used by the v5 engine.
# ----------------------------------------------------------------------------
NIFTY_BROKER=upstox
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
ANGELONE_ACCESS_TOKEN=
GROWW_ACCESS_TOKEN=
# Change this if you run the legacy terminal: it guards an endpoint that accepts broker tokens.
NIFTY_ADMIN_PIN=change-me
PORT=8000
